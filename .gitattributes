# Auto detect text files and perform LF normalization
* text=auto eol=lf

# JS and TS files must always use LF for tools to work
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# CSS files must always use LF for tools to work
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf

# Documentation
*.md text diff=markdown
*.mdx text diff=markdown

# Configs
*.json text
*.yaml text
*.yml text

# Graphics
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary

# Fonts
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary

# Scripts must retain LF endings
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts should retain CRLF endings
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
*.ps1 text eol=crlf